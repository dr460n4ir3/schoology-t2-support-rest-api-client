            {
              "key": "building_id",
              "value": "",
              "enabled": false,
              "secret": false
            }
          ],
          "headers": [],
          "body_mode": "none",
          "body": "",
          "form": [],
          "auth": {
            "type": "inherit"
          },
          "description": ""
        },
        {
          "type": "request",
          "id": "3b6b94472587",
          "name": "Get user's sections",
