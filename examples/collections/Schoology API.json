          "type": "request",
          "id": "5d238ff06633",
          "name": "Find users by school UID",
          "method": "GET",
          "url": "{{base_url}}/users",
          "params": [
            {
              "key": "school_uids",
              "value": "{{school_uid}}",
              "enabled": true,
              "secret": false
