          "id": "dd174d3e2ead",
          "name": "Who am I (app-user-info)",
          "method": "GET",
          "url": "{{base_url}}/app-user-info",
          "params": [],
          "headers": [],
          "body_mode": "none",
          "body": "",
          "form": [],
          "auth": {
            "type": "inherit"
          },
          "description": "Confirms the API keys work and shows which user/school they belong to."
        },
        {
          "type": "request",
          "id": "e7a33968ded2",
