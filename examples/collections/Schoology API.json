          "auth": {
            "type": "inherit"
          },
          "description": ""
        },
        {
          "type": "request",
          "id": "f8f62f66973b",
          "name": "Update user",
          "method": "PUT",
          "url": "{{base_url}}/users/{{user_id}}",
          "params": [],
          "headers": [],
          "body_mode": "json",
          "body": "{\n  \"email\": \"{{email}}\"\n}",
          "form": [],
          "auth": {
            "type": "inherit"
          },
          "description": "Changes data! Edit the body to the fields you need. In the Bulk Runner, CSV columns (user_id, email) fill the {{variables}}."
        }
      ]
    },
