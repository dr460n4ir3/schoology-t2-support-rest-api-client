{
  "format": "restclient-collection/1",
  "id": "oneroster-1-2",
  "name": "OneRoster 1.2",
  "description": "OneRoster 1.2 rostering endpoints for SIS troubleshooting (PowerSchool SIS, Infinite Campus, ...). Set oneroster_base_url and credentials in an environment. Default auth is OAuth 2.0 client credentials; an environment can override it (e.g. Infinite Campus OneRoster 1.1 uses OAuth 1.0 HMAC-SHA256). Tip: turn on 'Fetch all pages' on a list request to pull every record.",
  "variables": [],
  "auth": {
    "type": "oauth2",
    "token_url": "{{token_url}}",
    "client_id": "{{client_id}}",
    "client_secret": "{{client_secret}}",
    "scope": "",
    "client_auth": "basic"
  },
  "items": [
    {
      "type": "folder",
      "id": "auth-or12",
      "name": "Auth",
      "description": "Token troubleshooting.",
      "items": [
        {
          "type": "request",
          "id": "get-token-or12",
          "name": "Get access token (debug)",
          "method": "POST",
          "url": "{{token_url}}",
          "params": [],
          "headers": [
            {
              "key": "Accept",
              "value": "application/json",
              "enabled": true,
              "secret": false
            }
          ],
          "body_mode": "urlencoded",
          "body": "",
          "form": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "enabled": true,
              "secret": false
            },
            {
              "key": "scope",
              "value": "{{scope}}",
              "enabled": false,
              "secret": false
            },
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "enabled": false,
              "secret": false
            },
            {
              "key": "client_secret",
              "value": "{{client_secret}}",
              "enabled": false,
              "secret": true
            }
          ],
          "auth": {
            "type": "basic",
            "username": "{{client_id}}",
            "password": "{{client_secret}}"
          },
          "description": "Debug only: shows the raw token response from the SIS. You don't need to run this first; every other request in this collection gets a token automatically. Use it when calls fail with 401/403 to check the token URL, client ID and secret. Sends client_id/client_secret as HTTP Basic auth (most SIS servers). If the server wants them in the body instead, set Auth to 'No auth' and enable the client_id/client_secret rows under Body. Not used by Infinite Campus OneRoster 1.1 (that uses OAuth 1.0 signing, no token)."
        }
      ]
    },
