{
  "servers": {
    "schoology-api-client": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "restclient.mcp_server"],
      "cwd": "${workspaceFolder}"
    },
    "schoology-api-client-mac": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "restclient.mcp_server"],
      "cwd": "${workspaceFolder}"
    }
  }
}
